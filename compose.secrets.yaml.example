# Copy this file to compose.secrets.yaml. Delete each source and matching service
# entry for credentials you do not use, then create the remaining ignored files.
# Start with: docker compose -f compose.yaml -f compose.secrets.yaml up -d
services:
  price-oracle-engine:
    secrets:
      - source: csfloat_api_key
        target: CS2_CSFLOAT_API_KEY
      - source: discord_webhook_url
        target: CS2_DISCORD_WEBHOOK_URL

secrets:
  csfloat_api_key:
    file: ./secrets/CS2_CSFLOAT_API_KEY
  discord_webhook_url:
    file: ./secrets/CS2_DISCORD_WEBHOOK_URL

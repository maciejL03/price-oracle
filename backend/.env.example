# The Docker quick start defaults to a completely offline, simulated demo.
CS2_OPERATING_MODE=demo
CS2_DEMO_SEED_ENABLED=true

# Docker Compose host ports (these are Compose substitutions, not engine fields).
CS2_FRONTEND_PORT=5173
CS2_API_PORT=8000

# Engine job infrastructure. Every value must be greater than zero.
CS2_WORKER_COUNT=5
CS2_JOB_QUEUE_CAPACITY=100
CS2_JOB_SHUTDOWN_TIMEOUT_SECONDS=10.0

# SQLite persistence. The parent directory is created during storage startup.
CS2_DATABASE_PATH=data/demo.sqlite3
# For public mode, use a separate path such as data/public.sqlite3.
CS2_DATABASE_BUSY_TIMEOUT_SECONDS=5.0

# Lifecycle scheduling and quote freshness.
CS2_SCHEDULER_POLL_SECONDS=0.1
CS2_QUOTE_MAX_AGE_SECONDS=300.0

# Public-mode providers. These settings are ignored in offline demo mode.
CS2_STEAM_ENABLED=true
CS2_STEAM_COUNTRY=GB
CS2_STEAM_CURRENCY_CODE=2
CS2_STEAM_CURRENCY=GBP
CS2_STEAM_CACHE_TTL_SECONDS=60
CS2_SKINPORT_ENABLED=true
CS2_SKINPORT_CURRENCY=GBP
CS2_SKINPORT_CACHE_TTL_SECONDS=300

# CSFloat listing reads can be attempted without a key. A key is optional.
CS2_CSFLOAT_ENABLED=true
CS2_CSFLOAT_CURRENCY=GBP
CS2_CSFLOAT_TIMEOUT_SECONDS=10.0
# CS2_CSFLOAT_API_KEY=<api-key>

# Optional Discord notification destination. Treat the entire URL as a secret.
# CS2_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Docker Secrets use the same prefixed names. For example, mount a file named
# CS2_DISCORD_WEBHOOK_URL under /run/secrets/ to configure the webhook in Docker.
# Environment variables and .env values take precedence over mounted files.
